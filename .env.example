# ---- required ----
# Any long random string. Protects the dashboard behind one passphrase.
APP_PASSPHRASE="change-me-to-something-long"
# Used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=""

# ---- state storage (Turso, free tier) ----
# turso db create daymark && turso db show daymark --url
TURSO_DATABASE_URL=""
# turso db tokens create daymark
TURSO_AUTH_TOKEN=""

# ---- Canvas ----
# Calendar > Calendar Feed, bottom right of canvas.unm.edu
CANVAS_ICS_URL="https://canvas.unm.edu/feeds/calendars/user_XXXX.ics"
# OPTIONAL. Unlocks real grades + true submission status.
# canvas.unm.edu > Account > Settings > New Access Token.
# Server-side only; never shipped to the browser.
CANVAS_API_TOKEN=""
CANVAS_BASE_URL="https://canvas.unm.edu"

# ---- location (Albuquerque; NWS needs no key) ----
LAT="35.1064"
LON="-106.632"
# NWS asks that you identify yourself. Any contact string is fine.
NWS_USER_AGENT="daymark (bquinonez223@gmail.com)"

# ---- Spotify (optional, phase 2) ----
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""

# ---- Gmail and YouTube (optional, separate read-only consent) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Production defaults to https://hey-brayan.vercel.app; local loopback previews
# keep their own origin/port when unset. Register the exact /api/gmail/callback
# URL shown in Worth opening > Connection setup in your Google web OAuth client.
DAYMARK_URL=""
# YouTube uses the same OAuth client, with a separate callback and token.
# Enable YouTube Data API v3, add youtube.readonly to the consent configuration,
# and register the exact /api/youtube/callback URL shown on /connections.

# ---- Trakt (optional, public viewing history) ----
# Create/find your own app at https://trakt.tv/oauth/applications.
# This is the app client ID, not the user name or Stremio account password.
TRAKT_CLIENT_ID=""
TRAKT_USER="2701bry"
